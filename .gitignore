# Dependencies
node_modules/

# Build output
.next/
dist/
*.exe

# Environment & secrets
.env
.env.local
.env*.local
backend/.env.ex
# Secret untuk docker compose (JWT_SECRET, ADMIN_PASSWORD, dll)
.env.docker

# Database
*.db

# Runtime data (uploads, HLS segments, encryption keys, chunk temp)
# Pola detail untuk backend ada di backend/.gitignore
backend/uploads/
backend/hls_output/
backend/.chunks/
videos.json

# Logs
*.log

# Catatan/berkas kerja lokal yang tidak perlu ikut repo.
# Dokumentasi resmi (README.md dan docs/) tetap di-commit lewat pengecualian
# di bawah supaya rujukan endpoint ikut ter-version control.
*.md

# Dokumentasi resmi. Pola di dalam docs/ perlu ditulis eksplisit: git tidak
# masuk ke direktori yang sudah di-ignore, jadi `!docs/` saja tidak cukup.
!README.md
!docs/
!docs/*.md

# OS / IDE / deploy tools
.DS_Store
Thumbs.db
.vscode/
.idea/
.vercel/
.wrangler/

# Go binaries tanpa ekstensi (detail di backend/.gitignore)
backend/server
backend/videoplatform
