# Secrets untuk docker compose. JANGAN di-commit.
# File ini dibaca otomatis oleh compose dari folder repo.

# Generate ulang dengan:
#   openssl rand -hex 32   → JWT_SECRET
#   openssl rand -hex 16   → HLS_ENCRYPT_KEY
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32-minimal-32-karakter-panjang-sekarang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-kuat

# Kosongkan untuk transcoding tanpa enkripsi HLS.
HLS_ENCRYPT_KEY=

# URL yang dipakai browser untuk mengakses backend. Karena request
# diproxy lewat frontend, ini sama dengan URL frontend.
SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# true hanya kalau frontend diakses lewat HTTPS.
COOKIE_SECURE=false

# Opsional: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Kosongkan untuk SQLite, isi untuk PostgreSQL.
DATABASE_URL=