# Server: development | production
ENV=development
PORT=8080

# Database — SQLite untuk lokal.
# Production: isi DATABASE_URL (Postgres, mis. Neon) dan biarkan DB_PATH.
DB_PATH=./videoplatform.db
DATABASE_URL=

# Storage
UPLOAD_PATH=./uploads
HLS_OUTPUT_PATH=./hls_output

# Auth — WAJIB diganti di production.
# JWT_SECRET minimal 32 karakter (generate: openssl rand -hex 32)
JWT_SECRET=ganti-dengan-random-minimal-32-karakter
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-kuat

# HLS AES-128: 32 karakter hex / 16 byte (generate: openssl rand -hex 16).
# Kosongkan untuk transcoding tanpa enkripsi.
HLS_ENCRYPT_KEY=

# URL publik server (dipakai untuk absolute URL media)
SERVER_URL=http://localhost:8080
COOKIE_SECURE=false

# CORS — whitelist origin frontend, pisahkan dengan koma.
# Tidak ada lagi wildcard *.vercel.app / *.ngrok — daftarkan domain eksplisit.
CORS_ORIGIN=http://localhost:3000

# Opsional: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
