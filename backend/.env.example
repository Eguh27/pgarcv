# ============================================
# DEVELOPMENT (Lokal)
# ============================================
# Uncomment untuk development, comment untuk production

# ENV=development
# PORT=8080
# DATABASE_URL=              # kosong = pakai SQLite
# JWT_SECRET=dev-secret      # boleh asal-asalan di dev
# ADMIN_PASSWORD=admin123    # boleh asal-asalan di dev
# CLOUDINARY_URL=            # optional, pakai lokal storage kalau kosong
# SERVER_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# PRODUCTION (Render + Neon + Cloudinary)
# ============================================
# Ganti nilai2 ini dengan milikmu

ENV=production
PORT=8080

# JWT_SECRET: generate dengan: openssl rand -base64 32
# Harus MINIMAL 32 karakter random
JWT_SECRET=ZiA0AtYPU8bqIuaMNflMjjBGqHoCJkNg/w1fjwEYKFc=

# ADMIN_PASSWORD: password admin yang kuat
ADMIN_PASSWORD=kontolterbang99

ADMIN_USERNAME=admin

# DATABASE_URL: dari Neon PostgreSQL
# Format: postgresql://user:password@host:port/dbname?sslmode=require
